## (LEGADO) ZeroTier Central API token (https://my.zerotier.com/account)
## O launcher atual não depende de ZeroTier; mantenha vazio se não usar os endpoints /api/rooms/* ou /api/zerotier/*.
ZT_API_TOKEN=

## (LEGADO) Default networkId (16 hex). Rooms /api/rooms/* usam isso.
ZT_DEFAULT_NETWORK_ID=

## Optional shared secret to protect the API (x-api-key header)
LAN_CONTROLLER_API_KEY=

## VPN (WireGuard) - salas + geração de config
VPN_ENABLE=false
## P2P: o VPS coordena salas/conexões; compose.mesh.yml não retransmite jogos.
## Use wireguard para manter compatibilidade com launchers antigos.
VPN_TRANSPORT=easytier
VPN_MESH_PEERS=udp://vpn.mroz.dev.br:11010,tcp://vpn.mroz.dev.br:11010
WG_INTERFACE=ofvpn0
WG_LISTEN_PORT=51820
WG_ENDPOINT_HOST=vpn.mroz.dev.br
WG_ENDPOINT_PORT=51820
WG_SERVER_ADDRESS=10.77.0.1/24
WG_SUBNET_CIDR=10.77.0.0/24
WG_DNS=
VPN_ROOM_TTL_DAYS=2
VPN_PEER_TTL_DAYS=7
